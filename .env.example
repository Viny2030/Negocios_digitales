ENV=development

# Postgres en producción: postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./prescriptive.db

SECRET_KEY=replace-with-a-long-random-string

DATASETS_DIR=./storage/datasets
MODELS_DIR=./storage/models

CORS_ORIGINS=["*"]

# Broker/backend de Celery (cola de entrenamiento). Requiere Redis corriendo.
REDIS_URL=redis://localhost:6379/0

# Umbral de equidad (Demographic Parity) para promover un modelo de case2 a producción.
FAIRNESS_DP_THRESHOLD=0.10

# Ticketing (case3 - triaje de anomalías): URL de un webhook HTTP genérico (Jira/Opsgenie/
# Zendesk automation webhook, o un endpoint propio) al que se le hace POST cuando el triaje
# decide que una alerta necesita intervención humana. Si se deja vacío, no se crea ningún
# ticket real: solo se registra en el log (modo desarrollo/demo).
TICKETING_WEBHOOK_URL=
TICKETING_WEBHOOK_TIMEOUT_S=5.0
