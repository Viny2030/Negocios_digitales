ENV=development

# Postgres en producción: postgresql://user:password@host:5432/dbname
# (en Railway: DATABASE_URL=${{Postgres.DATABASE_URL}} en las variables del servicio de la API)
DATABASE_URL=sqlite:///./prescriptive.db

DATASETS_DIR=./storage/datasets
MODELS_DIR=./storage/models

CORS_ORIGINS=["*"]

# Topes de tamaño, en bytes (25 MB por archivo, 10 MB por JSON).
MAX_UPLOAD_BYTES=26214400
MAX_JSON_BODY_BYTES=10485760

# Límites de pedidos.
IP_RATE_LIMIT=600/minute
DEFAULT_RATE_LIMIT=120/minute
REGISTRATION_RATE_LIMIT=10/hour

# Cuántos proxies propios hay delante de la API. 0 si está expuesta directo.
# En un PaaS como Railway suele ser 1: confirmalo al desplegar. Con 0 detrás de un proxy,
# todos los clientes comparten una sola IP y por lo tanto el mismo límite.
TRUSTED_PROXY_HOPS=0
